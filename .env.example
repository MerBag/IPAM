# Copy this file to .env, restrict it to the service account, and replace every
# required blank value before starting the stack. Use URL-safe values (hex is
# ideal) because POSTGRES_PASSWORD is embedded in DATABASE_URL by Compose.

# Host port published by the outer nginx reverse proxy.
APP_PORT=80

# PostgreSQL is reachable only inside the Docker networks.
POSTGRES_DB=merbag_ipam
POSTGRES_USER=merbag
POSTGRES_PASSWORD=

# Generate independently: openssl rand -hex 64
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Safety cap for eager address-row creation when a prefix is added.
MAX_MATERIALIZED_ADDRESSES=65536

# The seed is idempotent. These values create the first administrator and prefix.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_PREFIX=203.0.113.0/24

# Comma-separated values. Add the deployment IP address and/or DNS name to
# TRUSTED_HOSTS. CORS is only needed for a separately hosted development UI.
TRUSTED_HOSTS=localhost,127.0.0.1,ipam.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=production
